  "techniqueDetails": {
    "capo": {
      "summary": "L'utilisation d'un capo est requise pour jouer la chanson dans la tonalité originale.",
      "steps": [
        "Placer le capo à la 7ème case."
      ]
    },
    "rythme feu de camp": {
      "summary": "Rythmique polyvalente, souvent qualifiée de 'couteau-suisse du guitariste', utilisable pour accompagner la plupart des chansons en croches.",
      "steps": [
        "Ne pas se fier à la formule 'Bas Bas Haut Haut Bas'.",
        "Comprendre le rythme pour savoir quand effectuer un mouvement 'bas' (aller) et 'haut' (retour)."
      ]
    },
    "syncopes": {
      "summary": "Technique rythmique qui implique de marquer virtuellement le 3ème temps.",
      "steps": []
    },
    "bas bas haut haut bas": {
      "summary": "Formule de rythmique souvent enseignée sur internet, mais considérée comme un piège car elle rend dépendant d'un tuto ou d'un professeur pour chaque chanson.",
      "steps": [
        "Ne pas céder à la facilité et à la tentation de cette formule.",
        "Comprendre le rythme pour savoir quand faire un mouvement 'bas' (aller) et 'haut' (retour) plutôt que de mémoriser cette séquence."
      ]
    },
    "syncope": {
      "summary": "Motif rythmique qui permet de mettre l'accent autre part que sur un temps, en avançant le moment où on marque le temps. On joue l'accord plus tôt et on ne joue pas le temps d'après.",
      "steps": [
        "Sur une mesure à 4 temps, l'impact du 3 n'est pas joué mais intégré au temps d'avant (le 2)",
        "On marque le « et », et pas le temps",
        "A la guitare, cela revient à faire un aller dans le vide."
      ]
    },
    "s'accompagner en chantant": {
      "summary": "Apprendre à mieux se synchroniser quand on chante en jouant. Cela devient possible quand jouer de la guitare est automatique et ne demande plus de concentration.",
      "steps": [
        "Chanter « Au clair de la lune » en jouant",
        "Choisir une tonalité (C, G, D) adaptée à sa voix pour faciliter l'exercice."
      ]
    },
    "apprendre à s'accompagner en chantant": {
      "summary": "Cette technique vise à améliorer la synchronisation entre le chant et le jeu de guitare, plutôt qu'à apprendre à chanter. Elle devient possible lorsque le jeu de guitare est devenu automatique et ne demande plus de concentration.",
      "steps": [
        "Pratiquer les rythmiques jusqu'à ce qu'elles soient naturelles et automatiques.",
        "Se concentrer sur la synchronisation de la voix avec le rythme.",
        "Ne pas se soucier de la justesse du chant lors de l'exercice.",
        "Utiliser des chansons simples comme 'Au clair de la lune' en C, G ou D pour s'exercer."
      ]
    },
    "embellissement autour du c": {
      "summary": "On ajoute le petit doigt en case 3 sur la corde de Mi aigu.",
      "image": "/assets/techniques/embellissement_autour_du_c_1774303474446.png"
    },
    "embellissement autour du a": {
      "summary": "",
      "image": "/assets/techniques/embellissement_autour_du_a_1774303717811.png"
    },
    "embellissement autour du d": {
      "title": "Embellissement autour du D",
      "summary": "Variations courtes autour de l’accord de D, ajoutant des notes de passage et suspensions.",
      "steps": [
        "Basculer entre D, Dsus2 et Dsus4",
        "Ajouter la basse A (D/A) pour varier la couleur",
        "Utiliser des hammer-on sur la corde de mi aigu (2→3) et pull-off (3→2)"
      ],
      "image": "/assets/techniques/embellissement_autour_du_d_1774310661052.png"
    },
    "changement d’accord sur le contre temps": {
      "summary": "",
      "steps": [
        "• Réussir à faire le changement d’accord en syncope",
        "• Réussir à l’intégrer dans une rythmique sans être perturbé",
        "• Réussir à remplir le vide de la syncope en tapant bien en rythme avec le pied"
      ],
      "image": "/assets/techniques/changement_d_accord_sur_le_contre_temps_1774462891239.png"
    }
  },
